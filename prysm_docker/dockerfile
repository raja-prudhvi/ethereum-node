# Stage 1: Build stage with debugging tools
FROM alpine:latest as build

RUN apk update && apk add --no-cache \
    curl \
    netcat-openbsd \
    bind-tools \
    bash

# Stage 2: Final image using Prysm beacon chain
FROM gcr.io/prysmaticlabs/prysm/beacon-chain:latest

# Copy debugging tools from the build stage
COPY --from=build /bin/bash /bin/bash
COPY --from=build /usr/bin/curl /bin/curl
COPY --from=build /usr/bin/nc /bin/nc

# Set correct entrypoint for Prysm
ENTRYPOINT ["/app/cmd/beacon-chain/beacon-chain"]
